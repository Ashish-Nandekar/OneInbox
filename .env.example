# Database
DATABASE_URL=postgresql://user:password@localhost:5432/oneinbox

# Authentication
# Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here-min-32-chars
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# Google OAuth
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# Sync intervals (in seconds)
TELEGRAM_POLL_INTERVAL=10
GMAIL_SYNC_INTERVAL=120
